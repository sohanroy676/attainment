# Copy to .env and fill in. Names only here: never commit real values.

# Django
DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Set to true ONLY for local http (no TLS). Turns off Secure cookies, HSTS and the https redirect.
ALLOW_INSECURE_HTTP=true
SITE_ADDRESS=:80

# PostgreSQL superuser (container bootstrap and test setup only; the app never uses it)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=attainment
# Owner role: runs migrations. App role: serves requests, not the table owner, no BYPASSRLS.
DB_OWNER_USER=attainment_owner
DB_OWNER_PASSWORD=
DB_APP_USER=attainment_app
DB_APP_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# Mail (leave empty to print mails to the console)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=attainment@localhost

# Password for demo accounts created by seed_demo (random if empty)
DEMO_PASSWORD=
